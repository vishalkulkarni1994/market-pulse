# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL (matches docker-compose.yml for local development)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/marketpulse

# Comma-separated RSS feeds. Defaults to Economy, Markets and Top stories.
# FEED_URLS=https://www.business-standard.com/rss/economy-102.rss,https://www.business-standard.com/rss/markets-106.rss,https://www.business-standard.com/rss/home_page_top_stories.rss

# Email only articles scoring at or above this priority (1 to 5)
PRIORITY_THRESHOLD=4

# Upper limit of LLM scoring calls in one run
MAX_SCORED_PER_RUN=30

# Scoring model (provider not chosen yet)
LLM_API_KEY=
LLM_MODEL=

# Recipient and sender of the digest email
EMAIL_TO=
EMAIL_FROM=

# EMAIL_PROVIDER_* settings (SMTP host/user/password or an API key)
# are added here once an email provider is chosen.

# When true, print the digest instead of sending it
DRY_RUN=true
